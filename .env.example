# 🔒 ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local (NEVER commit to git)

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
# These values are SAFE to expose in the frontend bundle (prefixed with VITE_)

# API Gateway endpoint (relative path is safer than absolute)
VITE_API_BASE_URL=/api

# Application name
VITE_APP_NAME=Beehive Associates

# Environment
VITE_ENV=production

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================
# These values are NEVER exposed to frontend

# Supabase Configuration (DO NOT PREFIX WITH VITE_)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here_NEVER_EXPOSE

# JWT Secret for custom auth
JWT_SECRET=your_jwt_secret_here_min_32_chars_long

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_here_min_32_chars_long

# Session Configuration
SESSION_TIMEOUT_MS=900000

# Rate Limiting
RATE_LIMIT_SUBMISSIONS_PER_MINUTE=1
RATE_LIMIT_SUBMISSIONS_PER_HOUR=3
RATE_LIMIT_SUBMISSIONS_PER_DAY=10
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MS=300000

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================

ENV=production
NODE_ENV=production

# Sentry (Error Tracking)
SENTRY_DSN=https://your_sentry_key@sentry.io/your_project_id

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# HTTPS
HTTPS_ENFORCE=true
HSTS_MAX_AGE=63072000

# CORS
ALLOWED_ORIGINS=https://beehiveassociates.com,https://www.beehiveassociates.com

# CSP
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' https://fonts.googleapis.com; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co; img-src 'self' data: https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';

# ============================================================================
# IMPORTANT NOTES
# ============================================================================

# 1. NEVER commit this file to git - add to .gitignore
# 2. Each environment (dev, staging, prod) should have separate .env files
# 3. Use a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.) for production
# 4. Rotate service role keys every 90 days
# 5. Use separate keys for development and production
# 6. Monitor .env file access with audit logs
